name: My Budget Calculator Android Build

on:
  push:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Set up Android SDK
        uses: android-actions/setup-android@v4
        with:
          accept-android-sdk-licenses: true
          packages: ''

      - name: Install Android SDK packages
        run: |
          sdkmanager "platforms;android-35" "build-tools;35.0.0"

      - name: Create Android project
        run: |
          mkdir -p app/src/main/java/mw/personalbudget/calculator

          cat > settings.gradle <<'EOF'
          pluginManagement {
              repositories {
                  google()
                  mavenCentral()
                  gradlePluginPortal()
              }
          }
          dependencyResolutionManagement {
              repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS)
              repositories {
                  google()
                  mavenCentral()
              }
          }
          rootProject.name = "MyBudgetCalculator"
          include ':app'
          EOF

          cat > build.gradle <<'EOF'
          plugins {
              id 'com.android.application' version '8.7.3' apply false
          }
          EOF

          cat > app/build.gradle <<'EOF'
          plugins {
              id 'com.android.application'
          }

          android {
              namespace 'mw.personalbudget.calculator'
              compileSdk 35

              defaultConfig {
                  applicationId 'mw.personalbudget.calculator'
                  minSdk 27
                  targetSdk 28
                  versionCode 1
                  versionName '1.0'
              }
          }
          EOF

          cat > app/src/main/AndroidManifest.xml <<'EOF'
          <manifest xmlns:android="http://schemas.android.com/apk/res/android">
              <application
                  android:allowBackup="true"
                  android:label="My Budget"
                  android:theme="@android:style/Theme.Material.Light.NoActionBar">
                  <activity
                      android:name=".MainActivity"
                      android:exported="true">
                      <intent-filter>
                          <action android:name="android.intent.action.MAIN" />
                          <category android:name="android.intent.category.LAUNCHER" />
                      </intent-filter>
                  </activity>
              </application>
          </manifest>
          EOF

          cat > app/src/main/java/mw/personalbudget/calculator/MainActivity.java <<'EOF'
          package mw.personalbudget.calculator;

          import android.app.Activity;
          import android.os.Bundle;
          import android.content.SharedPreferences;
          import android.graphics.Typeface;
          import android.widget.*;
          import java.util.ArrayList;
          import java.util.Locale;

          public class MainActivity extends Activity {
              SharedPreferences prefs;
              ArrayList<String> transactions = new ArrayList<>();
              LinearLayout history;
              TextView balanceView, incomeView, expenseView;
              EditText amountInput, descriptionInput;
              Spinner typeSpinner;
              double income = 0, expenses = 0;

              @Override
              protected void onCreate(Bundle savedInstanceState) {
                  super.onCreate(savedInstanceState);
                  prefs = getSharedPreferences("budget", MODE_PRIVATE);
                  loadData();
                  buildScreen();
                  updateSummary();
              }

              void buildScreen() {
                  ScrollView scroll = new ScrollView(this);
                  LinearLayout root = new LinearLayout(this);
                  root.setOrientation(LinearLayout.VERTICAL);
                  root.setPadding(24, 28, 24, 24);
                  root.setBackgroundColor(0xFFF4F6FA);
                  scroll.addView(root);

                  TextView title = new TextView(this);
                  title.setText("MY BUDGET");
                  title.setTextSize(25);
                  title.setTypeface(null, Typeface.BOLD);
                  title.setTextColor(0xFF173B66);
                  root.addView(title);

                  balanceView = new TextView(this);
                  balanceView.setTextSize(27);
                  balanceView.setTypeface(null, Typeface.BOLD);
                  balanceView.setTextColor(0xFF173B66);
                  balanceView.setPadding(0, 22, 0, 12);
                  root.addView(balanceView);

                  incomeView = new TextView(this);
                  expenseView = new TextView(this);
                  incomeView.setTextSize(16);
                  expenseView.setTextSize(16);
                  root.addView(incomeView);
                  root.addView(expenseView);

                  TextView heading = new TextView(this);
                  heading.setText("ADD TRANSACTION");
                  heading.setTextSize(18);
                  heading.setTypeface(null, Typeface.BOLD);
                  heading.setPadding(0, 28, 0, 12);
                  root.addView(heading);

                  descriptionInput = new EditText(this);
                  descriptionInput.setHint("Description (e.g. Salary, Food)");
                  root.addView(descriptionInput);

                  amountInput = new EditText(this);
                  amountInput.setHint("Amount in MWK");
                  amountInput.setInputType(8194);
                  root.addView(amountInput);

                  typeSpinner = new Spinner(this);
                  ArrayAdapter<String> adapter = new ArrayAdapter<>(
                      this, android.R.layout.simple_spinner_item,
                      new String[]{"Income", "Expense"});
                  adapter.setDropDownViewResource(
                      android.R.layout.simple_spinner_dropdown_item);
                  typeSpinner.setAdapter(adapter);
                  root.addView(typeSpinner);

                  Button addButton = new Button(this);
                  addButton.setText("ADD TRANSACTION");
                  root.addView(addButton);
                  addButton.setOnClickListener(v -> addTransaction());

                  TextView recent = new TextView(this);
                  recent.setText("RECENT TRANSACTIONS");
                  recent.setTextSize(18);
                  recent.setTypeface(null, Typeface.BOLD);
                  recent.setPadding(0, 28, 0, 12);
                  root.addView(recent);

                  history = new LinearLayout(this);
                  history.setOrientation(LinearLayout.VERTICAL);
                  root.addView(history);

                  Button resetButton = new Button(this);
                  resetButton.setText("RESET ALL DATA");
                  root.addView(resetButton);
                  resetButton.setOnClickListener(v -> confirmReset());

                  setContentView(scroll);
                  refreshHistory();
              }

              void addTransaction() {
                  String description = descriptionInput.getText().toString().trim();
                  String amountText = amountInput.getText().toString().trim();

                  if (description.isEmpty() || amountText.isEmpty()) {
                      Toast.makeText(this,
                          "Enter description and amount",
                          Toast.LENGTH_SHORT).show();
                      return;
                  }

                  try {
                      double amount = Double.parseDouble(amountText);

                      if (!Double.isFinite(amount) || amount <= 0) {
                          Toast.makeText(this,
                              "Enter a valid amount",
                              Toast.LENGTH_SHORT).show();
                          return;
                      }

                      boolean isIncome =
                          typeSpinner.getSelectedItemPosition() == 0;

                      if (isIncome) income += amount;
                      else expenses += amount;

                      String record = (isIncome ? "+ " : "- ")
                          + description + " — MWK "
                          + String.format(Locale.US, "%,.2f", amount);

                      transactions.add(0, record);

                      saveData();
                      updateSummary();
                      refreshHistory();
                      descriptionInput.setText("");
                      amountInput.setText("");

                      Toast.makeText(this,
                          "Transaction added",
                          Toast.LENGTH_SHORT).show();

                  } catch (NumberFormatException e) {
                      Toast.makeText(this,
                          "Enter a valid number",
                          Toast.LENGTH_SHORT).show();
                  }
              }

              void updateSummary() {
                  balanceView.setText(
                      "Balance: MWK " + money(income - expenses));
                  incomeView.setText(
                      "Total income: MWK " + money(income));
                  expenseView.setText(
                      "Total expenses: MWK " + money(expenses));
              }

              String money(double value) {
                  return String.format(Locale.US, "%,.2f", value);
              }

              void refreshHistory() {
                  if (history == null) return;

                  history.removeAllViews();

                  for (String item : transactions) {
                      TextView row = new TextView(this);
                      row.setText(item);
                      row.setTextSize(15);
                      row.setPadding(0, 10, 0, 10);
                      history.addView(row);
                  }

                  if (transactions.isEmpty()) {
                      TextView empty = new TextView(this);
                      empty.setText("No transactions yet.");
                      history.addView(empty);
                  }
              }

              void saveData() {
                  StringBuilder data = new StringBuilder();

                  for (String item : transactions) {
                      data.append(item.replace("\n", " ")).append("\n");
                  }

                  prefs.edit()
                      .putString("transactions", data.toString())
                      .putFloat("income", (float) income)
                      .putFloat("expenses", (float) expenses)
                      .apply();
              }

              void loadData() {
                  income = prefs.getFloat("income", 0);
                  expenses = prefs.getFloat("expenses", 0);

                  String data = prefs.getString("transactions", "");

                  for (String item : data.split("\n")) {
                      if (!item.isEmpty()) transactions.add(item);
                  }
              }

              void confirmReset() {
                  new android.app.AlertDialog.Builder(this)
                      .setTitle("Reset budget?")
                      .setMessage(
                          "This will permanently erase all transactions and totals.")
                      .setNegativeButton("Cancel", null)
                      .setPositiveButton("Reset", (dialog, which) -> {
                          income = 0;
                          expenses = 0;
                          transactions.clear();
                          prefs.edit().clear().apply();
                          updateSummary();
                          refreshHistory();
                      })
                      .show();
              }
          }
          EOF

      - name: Build APK
        run: gradle --no-daemon assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: My-Budget-Calculator-APK
          path: app/build/outputs/apk/debug/app-debug.apk